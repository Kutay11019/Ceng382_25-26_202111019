@page
@model RazorPagesProject.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <style>
        body {
            margin: 0;
            background-color: #d6eaff; /* Açık mavi */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            overflow: hidden;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-container {
            background-color: white;
            padding: 2.5rem 3rem;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 400px;
            text-align: center;
            z-index: 10;
        }

        .login-container h2 {
            margin-bottom: 1.5rem;
            color: #333;
        }

        .login-container input {
            width: 100%;
            padding: 0.75rem;
            margin-bottom: 1rem;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 1rem;
        }

        .login-container input:focus {
            border-color: #667eea;
            outline: none;
        }

        .login-container button {
            width: 100%;
            padding: 0.75rem;
            background-color: #667eea;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .login-container button:hover {
            background-color: #5a67d8;
        }

        .error-message {
            color: red;
            margin-top: 0.5rem;
        }

        /* Dekoratif imgeler */
        .decorative-img {
            position: absolute;
            width: 100px;
            opacity: 0.2;
            z-index: 1;
        }

        .img-top-left {
            top: 20px;
            left: 30px;
        }

        .img-bottom-right {
            bottom: 20px;
            right: 30px;
        }

        .img-top-right {
            top: 20px;
            right: 40px;
        }

        .img-bottom-left {
            bottom: 20px;
            left: 40px;
        }
    </style>
</head>
<body>

    <!-- Dekoratif istatistik/okul temalı imgeler -->
    <img src="https://cdn-icons-png.flaticon.com/512/3135/3135755.png" class="decorative-img img-top-left" alt="Student Icon" />
    <img src="https://cdn-icons-png.flaticon.com/512/2232/2232688.png" class="decorative-img img-bottom-right" alt="Chart Icon" />
    <img src="https://cdn-icons-png.flaticon.com/512/167/167707.png" class="decorative-img img-top-right" alt="Book Icon" />
    <img src="https://cdn-icons-png.flaticon.com/512/3575/3575193.png" class="decorative-img img-bottom-left" alt="Graph Icon" />

    <div class="login-container">
        <h2>Welcome Back</h2>
        <form method="post">
            <input type="text" name="Username" placeholder="Username" required />
            <input type="password" name="Password" placeholder="Password" required />
            <button type="submit">Login</button>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error-message">@Model.ErrorMessage</div>
            }
        </form>
    </div>
</body>
</html>