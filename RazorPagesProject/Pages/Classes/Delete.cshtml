@page "{id:int}"
@model RazorPagesProject.Pages.Classes.DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Class</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>@Model.Class.ClassName</h4>
</div>

<form method="post">
    <input type="hidden" asp-for="Class.Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-page="./Index">Cancel</a>
</form>