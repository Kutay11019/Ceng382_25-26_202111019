@page "{id:int}"
@model RazorPagesProject.Pages.Classes.EditModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Class</h1>

<form method="post">
    <input type="hidden" asp-for="Class.Id" />
    <div class="form-group">
        <label asp-for="Class.ClassName" class="control-label"></label>
        <input asp-for="Class.ClassName" class="form-control" />
        <span asp-validation-for="Class.ClassName" class="text-danger"></span>
    </div>
    <input type="submit" value="Save" class="btn btn-primary" />
</form>

<a asp-page="./Index">Back to List</a>